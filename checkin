void checkin(int bookid) {
    int bookFound = 0;
    for (int i = 0; i < totalBooks; i++) {
        if (books[i].id == bookid) {
            bookFound = 1;
            if (!books[i].isAvailable) {
                books[i].isAvailable = 1;
                printf("\nYou have successfully checked in '%s'.\n", books[i].title);
            } else {
                printf("\nThe book '%s' was not checked out.\n", books[i].title);
            }
            break;
        }
    }
    if (!bookFound) {
        printf("\nBook with ID %d not found.\n", bookid);
    }
}
