//funtion for searching books
void namesearch() {
    char searchQuery[100];
    int found = 0;

    printf("Enter the book title to search: ");
    scanf(" %[^\n]%*c", searchQuery);

    printf("\nSearch Results:\n");
    printf("%-5s %-30s %-30s %-10s\n", "ID", "Title", "Author", "Status");
    printf("---------------------------------------------------------------\n");

    for (int i = 0; i < totalBooks; i++) {
        if (strstr(books[i].title, searchQuery) != NULL) {
            printf("%-5d %-30s %-30s %-10s\n", books[i].id, books[i].title, books[i].author, books[i].isAvailable ? "Available" : "Checked Out");
            found = 1;
        }
    }

    if (!found) {
        printf("No books found with the title '%s'.\n", searchQuery);
    }
}

//Function for adding books
void addbook(int id, char *title, char *author, int isAvailable) {
    if (totalBooks < MAX_BOOKS) {
        books[totalBooks].id = id;
        strcpy(books[totalBooks].title, title);
        strcpy(books[totalBooks].author, author);
        books[totalBooks].isAvailable = isAvailable;
        totalBooks++;
        printf("Book '%s' added successfully!\n", title);
    } else {
        printf("Book list is full!\n");
    }
}


//Function to remove books
void removebook(int bookid) {
    int bookFound = 0;
    for (int i = 0; i < totalBooks; i++) {
        if (books[i].id == bookid) {
            bookFound = 1;
            for (int j = i; j < totalBooks - 1; j++) {
                books[j] = books[j + 1];
            }
            totalBooks--;
            printf("Book with ID %d removed successfully!\n", bookid);
            break;
        }
    }
    if (!bookFound) {
        printf("Book with ID %d not found.\n", bookid);
    }
}

//Function for checkout
void checkout(bookid) {
    int book_choice;
    char title[100];
    char author[100];

    printf("\nChoose an option:\n1. Add a book\n2. Remove a book\n3. Check out a book\nEnter your choice: ");
    scanf("%d", &book_choice);

    switch (book_choice) {
        case 1:
            // Add a book
            printf("Enter Book ID: ");
            scanf("%d", &bookid);
            printf("Enter Book Title: ");
            scanf(" %[^\n]%*c", title);
            printf("Enter Book Author: ");
            scanf(" %[^\n]%*c", author);
            addbook(bookid, title, author, 1);

            printf("\nYou have added a book. What would you like to do next?\n");
            printf("2. Remove a book\n3. Check out a book\nEnter your choice: ");
            int next_choice;
            scanf("%d", &next_choice);

            switch (next_choice) {
                case 2:
                    // Remove a book
                    printf("Enter Book ID to remove: ");
                    scanf("%d", &bookid);
                    removebook(bookid);
                    checkout(bookid);
                    break;

                case 3:
                    // Check out a book
                    printf("Enter Book ID to check out: ");
                    scanf("%d", &bookid);

                    int bookFound = 0;
                    for (int i = 0; i < totalBooks; i++) {
                        if (books[i].id == bookid) {
                            bookFound = 1;
                            if (books[i].isAvailable) {
                                books[i].isAvailable = 0;
                                printf("\nYou have successfully checked out '%s'.\n", books[i].title);
                            } else {
                                printf("\nSorry, the book '%s' is already checked out.\n", books[i].title);
                            }
                            break;
                        }
                    }

                    if (!bookFound) {
                        printf("\nBook with ID %d not found. You can only check out books that are currently available in the library.\n", bookid);
                    }
                    break;

                default:
                    printf("Invalid choice. Returning to main menu.\n");
                    break;
            }
            break;

        case 2:
            // Remove a book
            printf("Enter Book ID to remove: ");
            scanf("%d", &bookid);
            removebook(bookid);
            break;

        case 3:
            // Check out a book
            printf("Enter Book ID to check out: ");
            scanf("%d", &bookid);

            int bookFound = 0;
            for (int i = 0; i < totalBooks; i++) {
                if (books[i].id == bookid) {
                    bookFound = 1;
                    if (books[i].isAvailable) {
                        books[i].isAvailable = 0;
                        printf("\nYou have successfully checked out '%s'.\n", books[i].title);
                    } else {
                        printf("\nSorry, the book '%s' is already checked out.\n", books[i].title);
                    }
                    break;
                }
            }

            if (!bookFound) {
                printf("\nBook with ID %d not found. You can only check out books that are currently available in the library.\n", bookid);
            }
            break;

        default:
            printf("Invalid choice. Please try again.\n");
            break;
    }

    printf("\nWould you like to perform another action? (1: Yes, 0: No): ");
    int continue_choice;
    scanf("%d", &continue_choice);
    if (continue_choice == 1) {
        checkout(bookid);
    } else {
        printf("\nExiting checkout process.\n");
        studentmenu();
    }
}

// Function to calculate the difference in days between two dates
int calculatetime(struct tm checkOutDate, struct tm checkInDate) {
    time_t checkOutTime = mktime(&checkOutDate);
    time_t checkInTime = mktime(&checkInDate);

    if (checkOutTime == -1 || checkInTime == -1) {
        printf("Error converting dates to time.\n");
        return -1;
    }

    double seconds = difftime(checkInTime, checkOutTime);
    int days = (int)(seconds / (60 * 60 * 24));
    return days;
}

// Function to calculate the late fee
void calculatefee() {
    struct tm checkOutDate = {0}, checkInDate = {0};

    printf("Enter check-out date (YYYY MM DD): ");
    if (scanf("%d %d %d", &checkOutDate.tm_year, &checkOutDate.tm_mon, &checkOutDate.tm_mday) != 3) {
        printf("Invalid input. Please use the format YYYY MM DD.\n");
        return;
    }

    checkOutDate.tm_year -= 1900;
    checkOutDate.tm_mon -= 1;

    printf("Enter check-in date (YYYY MM DD): ");
    if (scanf("%d %d %d", &checkInDate.tm_year, &checkInDate.tm_mon, &checkInDate.tm_mday) != 3) {
        printf("Invalid input. Please use the format YYYY MM DD.\n");
        return;
    }

    checkInDate.tm_year -= 1900;
    checkInDate.tm_mon -= 1;

    // Calculate the days between check-out and check-in
    int days = calculatetime(checkOutDate, checkInDate);
    if (days == -1) {
        return;
    }

    printf("Days between check-out and check-in: %d\n", days);

    // Calculate and display the fine if applicable
    if (days > ALLOWED_DAYS) {
        int fine = (days - ALLOWED_DAYS) * DAILY_FINE;
        printf("Late fee: %d tk\n", fine);
        printf("please pay in the accounts center and provide admin with receipt\n");
    } else {
        printf("No late fee. Returned within the allowed period.\n");
    }
}

// Check-in function
void checkin(int bookid) {
    int bookFound = 0;

    for (int i = 0; i < totalBooks; i++) {
        if (books[i].id == bookid) {
            bookFound = 1;

            if (!books[i].isAvailable) {
                books[i].isAvailable = 1;
                printf("\nYou have successfully checked in '%s'.\n", books[i].title);
                calculatefee();
                printf("you are being directed back to menu\n");
            } else {
                printf("\nThe book '%s' was not checked out.\n", books[i].title);
            }
            break;
        }
    }

    if (!bookFound) {
        printf("\nBook with ID %d not found.\n", bookid);
    }
}

// Function to process the fee payment
void feeprocess() {
    int transactionId;
    double amount;

    printf("Enter Transaction ID: ");
    scanf("%d", &transactionId);

    printf("Enter the amount paid: ");
    scanf("%lf", &amount);

    // Process the transaction
    totalTransactions++;
    totalRevenue += amount;

    printf("Transaction ID %d has been processed. Fee has been paid.\n", transactionId);
    printf("Total number of fees paid: %d\n", totalTransactions);
    printf("Total revenue made by the library: %.2f tk\n", totalRevenue);
}


