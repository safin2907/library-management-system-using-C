void checkout(bookid) {
    int book_choice;
    char title[100];
    char author[100];

    printf("\nChoose an option:\n1. Add a book\n2. Remove a book\n3. Check out a book\nEnter your choice: ");
    scanf("%d", &book_choice);

    switch (book_choice) {
        case 1:
            // Add a book
            printf("Enter Book ID: ");
            scanf("%d", &bookid);
            printf("Enter Book Title: ");
            scanf(" %[^\n]%*c", title); // To read string with spaces
            printf("Enter Book Author: ");
            scanf(" %[^\n]%*c", author); // To read string with spaces
            addbook(bookid, title, author, 1); // New book is available by default

            // After adding, offer options to remove or check out
            printf("\nYou have added a book. What would you like to do next?\n");
            printf("2. Remove a book\n3. Check out a book\nEnter your choice: ");
            int next_choice;
            scanf("%d", &next_choice);

            switch (next_choice) {
                case 2:
                    // Remove a book
                    printf("Enter Book ID to remove: ");
                    scanf("%d", &bookid);
                    removebook(bookid);
                    checkout(bookid);
                    break;

                case 3:
                    // Check out a book
                    printf("Enter Book ID to check out: ");
                    scanf("%d", &bookid);

                    int bookFound = 0;
                    for (int i = 0; i < totalBooks; i++) {
                        if (books[i].id == bookid) {
                            bookFound = 1;
                            if (books[i].isAvailable) {
                                books[i].isAvailable = 0;
                                printf("\nYou have successfully checked out '%s'.\n", books[i].title);
                            } else {
                                printf("\nSorry, the book '%s' is already checked out.\n", books[i].title);
                            }
                            break;
                        }
                    }

                    if (!bookFound) {
                        printf("\nBook with ID %d not found. You can only check out books that are currently available in the library.\n", bookid);
                    }
                    break;

                default:
                    printf("Invalid choice. Returning to main menu.\n");
                    break;
            }
            break;

        case 2:
            // Remove a book
            printf("Enter Book ID to remove: ");
            scanf("%d", &bookid);
            removebook(bookid);
            break;

        case 3:
            // Check out a book
            printf("Enter Book ID to check out: ");
            scanf("%d", &bookid);

            int bookFound = 0;
            for (int i = 0; i < totalBooks; i++) {
                if (books[i].id == bookid) {
                    bookFound = 1;
                    if (books[i].isAvailable) {
                        books[i].isAvailable = 0;
                        printf("\nYou have successfully checked out '%s'.\n", books[i].title);
                    } else {
                        printf("\nSorry, the book '%s' is already checked out.\n", books[i].title);
                    }
                    break;
                }
            }

            if (!bookFound) {
                printf("\nBook with ID %d not found. You can only check out books that are currently available in the library.\n", bookid);
            }
            break;

        default:
            printf("Invalid choice. Please try again.\n");
            break;
    }

    // Ask the user if they want to perform another action
    printf("\nWould you like to perform another action? (1: Yes, 0: No): ");
    int continue_choice;
    scanf("%d", &continue_choice);
    if (continue_choice == 1) {
        checkout(bookid); // Recursive call for the next action
    } else {
        printf("\nExiting checkout process.\n");
    }
}
