// Function to handle student access
void student() {
    char studentID[50];

    printf("\n-----Student Login-----\n\n");
    printf("Enter Student ID: ");
    scanf("%s", studentID);

    // Assuming any non-empty input is valid for simplicity
    if (strlen(studentID) > 0) {
        printf("\nAccess Granted! Welcome, Student %s!\n", studentID);
        studentmenu();
    } else {
        printf("\nAccess Denied! Invalid Student ID.\n");
    }
}

// Function to display the student menu
