    printf("1. View Personal Record\n");
    printf("2. Update Personal Information\n");
    printf("3. Logout\n");

    printf("Enter your choice: ");
    scanf("%d", &student_choice);

    switch (student_choice) {
        case 1:
            printf("Viewing personal record...\n");
            break;
        case 2:
            printf("Updating personal information...\n");
            break;
