void studentmenu() {
    int student_choice;
    int bookid;

    do {
        printf("\n\n-----Student Menu-----\n\n");
        printf("1. View book list\n");
        printf("2. Search book\n");
        printf("3. Check out\n");
        printf("4. Check in\n");
        printf("5. Sign out\n");

        printf("Enter your choice: ");
        scanf("%d", &student_choice);

        switch (student_choice) {
            case 1:
                printf("1 - Demons - Fyodor Dostoevsky\n2 - The Castle - Franz Kafka\n3 - AGGTM - Holly Jackson\n4 - After Dark - Haruki Murakami\n5 - The Midnight Library - Matt Haig\n");
                viewlist();
                break;
            case 2:
                namesearch();
                printf("\nWould you like to:\n1. Return to Main Menu\n2. Sign out\nEnter your choice: ");
                int after_search_choice;
                scanf("%d", &after_search_choice);
                if (after_search_choice == 1) {
                    continue; 
                } else if (after_search_choice == 2) {
                    signout();
                    return;
                } else {
                    printf("Invalid choice! Returning to main menu.\n");
                }
                break;
            case 3:
                printf("1 - Demons - Fyodor Dostoevsky\n2 - The Castle - Franz Kafka\n3 - AGGTM - Holly Jackson\n4 - After Dark - Haruki Murakami\n5 - The Midnight Library - Matt Haig\n");
                checkout(bookid);
                break;
            case 4:
                printf("1 - Demons - Fyodor Dostoevsky\n2 - The Castle - Franz Kafka\n3 - AGGTM - Holly Jackson\n4 - After Dark - Haruki Murakami\n5 - The Midnight Library - Matt Haig\n");
                scanf("%d", &bookid);
                checkin(bookid);
                break;
            case 5:
                signout();
                return;
            default:
                printf("Invalid choice!\n");
        }
    } while (student_choice != 5); // Keep showing the menu until the student chooses to sign out
}
