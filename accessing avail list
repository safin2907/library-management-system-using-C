#include <stdio.h>
#include <string.h>

// Define the maximum number of books in the library
#define MAX_BOOKS 100

// Structure to store book information
typedef struct {
    int id;
    char title[50];
    char author[50];
    int isAvailable;  // 1 if available, 0 if checked out
    char borrower[50];
} Book;

// Global array of books
Book library[MAX_BOOKS];
int totalBooks = 0;

// Function to check out a book
void checkOutBook() {
    int bookID;
    char borrowerName[50];

    printf("Enter Book ID to check out: ");
    scanf("%d", &bookID);

    // Search for the book by ID
    for (int i = 0; i < totalBooks; i++) {
        if (library[i].id == bookID) {
            if (library[i].isAvailable) {
                printf("Enter Borrower's Name: ");
                scanf(" %[^\n]", borrowerName);
                library[i].isAvailable = 0;
                strcpy(library[i].borrower, borrowerName);
                printf("Book '%s' checked out successfully by %s.\n", library[i].title, library[i].borrower);
            } else {
                printf("Book '%s' is already checked out by %s.\n", library[i].title, library[i].borrower);
            }
            return;
        }
    }
    printf("Book with ID %d not found.\n", bookID);
}

// Function to check in a book
void checkInBook() {
    int bookID;

    printf("Enter Book ID to check in: ");
    scanf("%d", &bookID);

    // Search for the book by ID
    for (int i = 0; i < totalBooks; i++) {
        if (library[i].id == bookID) {
            if (!library[i].isAvailable) {
                library[i].isAvailable = 1;
                strcpy(library[i].borrower, "");
                printf("Book '%s' checked in successfully.\n", library[i].title);
            } else {
                printf("Book '%s' is already available in the library.\n", library[i].title);
            }
            return;
        }
    }
    printf("Book with ID %d not found.\n", bookID);
}

// Function to display all books in the library
void displayBooks() {
    printf("\n%-5s %-30s %-30s %-15s\n", "ID", "Title", "Author", "Status");
    printf("---------------------------------------------------------------\n");
    for (int i = 0; i < totalBooks; i++) {
        printf("%-5d %-30s %-30s %-15s\n", library[i].id, library[i].title, library[i].author,
               library[i].isAvailable ? "Available" : library[i].borrower);
    }
}

// Function to display only available books
void displayAvailableBooks() {
    int availableCount = 0;
    printf("\nAvailable Books:\n");
    printf("%-5s %-30s %-30s\n", "ID", "Title", "Author");
    printf("---------------------------------------------------\n");
    for (int i = 0; i < totalBooks; i++) {
        if (library[i].isAvailable) {
            printf("%-5d %-30s %-30s\n", library[i].id, library[i].title, library[i].author);
            availableCount++;
        }
    }
    if (availableCount == 0) {
        printf("No books are currently available.\n");
    }
}

// Function to add sample books to the library
void addSampleBooks() {
    strcpy(library[0].title, "C Programming Language");
    strcpy(library[0].author, "Kernighan & Ritchie");
    library[0].id = 1;
    library[0].isAvailable = 1;

    strcpy(library[1].title, "Clean Code");
    strcpy(library[1].author, "Robert C. Martin");
    library[1].id = 2;
    library[1].isAvailable = 1;

    strcpy(library[2].title, "The Pragmatic Programmer");
    strcpy(library[2].author, "Andrew Hunt & David Thomas");
    library[2].id = 3;
    library[2].isAvailable = 0; // Checked out

    totalBooks = 3;
}

// Main function
int main() {
    int choice;
    addSampleBooks();

    while (1) {
        printf("\nLibrary Management System\n");
        printf("1. Check Out Book\n");
        printf("2. Check In Book\n");
        printf("3. Display All Books\n");
        printf("4. Display Available Books\n");
        printf("5. Exit\n");
        printf("Enter your choice: ");
        scanf("%d", &choice);

        switch (choice) {
            case 1:
                checkOutBook();
                break;
            case 2:
                checkInBook();
                break;
            case 3:
                displayBooks();
                break;
            case 4:
                displayAvailableBooks();
                break;
            case 5:
                printf("Exiting the system...\n");
                return 0;
            default:
                printf("Invalid choice! Please try again.\n");
        }
    }
    return 0;
}
