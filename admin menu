// Function to display the admin menu
void adminmenu() {
    int admin_choice;

    while (1) {
        printf("\n-----Admin Menu-----\n\n");
        printf("1. View All Records\n");
        printf("2. Process Fee Payment\n");
        printf("3. Add Book to List\n");
        printf("4. Remove Book from List\n");
        printf("5. View Fee History\n");
        printf("6. Logout\n");

        printf("Enter your choice: ");
        scanf("%d", &admin_choice);

        switch (admin_choice) {
            case 1:
                printf("\n\n----RECORDS----\n\n");
                for (int i = 0; i < totalBooks; i++) {
                    printf("%d - %s - %s\n", books[i].id, books[i].title, books[i].author);
                }
                break;
            case 2:
                feeprocess();
                break;
            case 3:
                addtolist();
                break;
            case 4:
                removefromlist();
                break;
            case 5:
                feehistory();
                break;
            case 6:
                signout();
                return;
            default:
                printf("Invalid choice! Please try again.\n");
        }

        printf("\nWould you like to:\n1. Return to Main Menu\n2. Sign out\nEnter your choice: ");
        int after_action_choice;
        scanf("%d", &after_action_choice);
        if (after_action_choice == 1) {
            continue;
        } else if (after_action_choice == 2) {
            signout();
            return;
        } else {
            printf("Invalid choice! Returning to main menu.\n");
        }
    }
}
