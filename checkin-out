typedef struct {
    int id;
    char title[100];
    char author[100];
    int isAvailable; // 1 if available, 0 if checked out
} Book;

Book books[] = {
    {1, "The Great Gatsby", "F. Scott Fitzgerald", 1},
    {2, "1984", "George Orwell", 1},
    {3, "To Kill a Mockingbird", "Harper Lee", 1},
    {4, "The Catcher in the Rye", "J.D. Salinger", 1},
    {5, "Moby-Dick", "Herman Melville", 1}
};

// Function to view the list of books
void viewlist() {
    printf("\nAvailable Books:\n");
    printf("%-5s %-30s %-30s %-10s\n", "ID", "Title", "Author", "Status");
    printf("---------------------------------------------------------------\n");
    for (int i = 0; i < totalBooks; i++) {
        printf("%-5d %-30s %-30s %-10s\n", books[i].id, books[i].title, books[i].author, books[i].isAvailable ? "Available" : "Checked Out");
    }

    int book_choice;
    printf("\nChoose an option:\n1. Check out a book\n2. Check in a book\n3. Return to Student Menu\nEnter your choice: ");
    scanf("%d", &book_choice);

    int bookid; // Variable to store the book ID
    switch(book_choice) {
        case 1:
            printf("Enter Book ID to check out: ");
            scanf("%d", &bookid);
            checkout(bookid);
            break;
        case 2:
            printf("Enter Book ID to check in: ");
            scanf("%d", &bookid);
            checkin(bookid);
            break;
        case 3:
            studentmenu();
            break;
        default:
            printf("Invalid choice. Please try again.\n");
    }
}

// Function to check out a book
void checkout(int bookid) {
    int bookFound = 0;
    for (int i = 0; i < totalBooks; i++) {
        if (books[i].id == bookid) {
            bookFound = 1;
            if (books[i].isAvailable) {
                books[i].isAvailable = 0;
                printf("\nYou have successfully checked out '%s'.\n", books[i].title);
            } else {
                printf("\nSorry, the book '%s' is already checked out.\n", books[i].title);
            }
            break;
        }
    }
    if (!bookFound) {
        printf("\nBook with ID %d not found.\n", bookid);
    }
}

// Function to check in a book
void checkin(int bookid) {
    int bookFound = 0;
    for (int i = 0; i < totalBooks; i++) {
        if (books[i].id == bookid) {
            bookFound = 1;
            if (!books[i].isAvailable) {
                books[i].isAvailable = 1;
                printf("\nYou have successfully checked in '%s'.\n", books[i].title);
            } else {
                printf("\nThe book '%s' was not checked out.\n", books[i].title);
            }
            break;
        }
    }
    if (!bookFound) {
        printf("\nBook with ID %d not found.\n", bookid);
    }
}
