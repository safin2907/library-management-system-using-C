// Function to add books to the list
void addtolist() {
    if (totalBooks >= MAX_BOOKS) {
        printf("Book list is full!\n");
        return;
    }

    int id;
    char title[100];
    char author[100];

    printf("Enter Book ID: ");
    scanf("%d", &id);
    printf("Enter Book Title: ");
    scanf(" %[^\n]%*c", title);
    printf("Enter Book Author: ");
    scanf(" %[^\n]%*c", author);

    books[totalBooks].id = id;
    strcpy(books[totalBooks].title, title);
    strcpy(books[totalBooks].author, author);
    books[totalBooks].isAvailable = 1;
    totalBooks++;

    printf("Book '%s' added successfully!\n", title);
}

// Function to remove books from the list
void removefromlist() {
    int id;
    printf("Enter Book ID to remove: ");
    scanf("%d", &id);

    int bookFound = 0;
    for (int i = 0; i < totalBooks; i++) {
        if (books[i].id == id) {
            bookFound = 1;
            for (int j = i; j < totalBooks - 1; j++) {
                books[j] = books[j + 1];
            }
            totalBooks--;
            printf("Book with ID %d removed successfully!\n", id);
            break;
        }
    }

    if (!bookFound) {
        printf("Book with ID %d not found.\n", id);
    }
}
