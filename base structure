#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#define MAX_BOOKS 100
#define MAX_USERS 100

typedef struct {
    char username[50];
    char password[50];
    char role[10];  // admin, librarian, customer
} User;

typedef struct {
    int id;
    char title[100];
    char author[100];
    int quantity;
    float price;
} Book;

typedef struct {
    Book books[MAX_BOOKS];
    int book_count;
    User users[MAX_USERS];
    int user_count;
} Library;

Library library;

void init_library() {
    library.book_count = 0;
    library.user_count = 0;
}

void add_user(char *username, char *password, char *role) {
    strcpy(library.users[library.user_count].username, username);
    strcpy(library.users[library.user_count].password, password);
    strcpy(library.users[library.user_count].role, role);
    library.user_count++;
}

void add_book(int id, char *title, char *author, int quantity, float price) {
    library.books[library.book_count].id = id;
    strcpy(library.books[library.book_count].title, title);
    strcpy(library.books[library.book_count].author, author);
    library.books[library.book_count].quantity = quantity;
    library.books[library.book_count].price = price;
    library.book_count++;
}

void view_books() {
    for (int i = 0; i < library.book_count; i++) {
        printf("ID: %d, Title: %s, Author: %s, Quantity: %d, Price: %.2f\n",
               library.books[i].id, library.books[i].title, library.books[i].author,
               library.books[i].quantity, library.books[i].price);
    }
}

int authenticate_user(char *username, char *password, char *role) {
    for (int i = 0; i < library.user_count; i++) {
        if (strcmp(library.users[i].username, username) == 0 &&
            strcmp(library.users[i].password, password) == 0 &&
            strcmp(library.users[i].role, role) == 0) {
            return 1;
        }
    }
    return 0;
}

int main() {
    init_library();
    add_user("admin", "admin123", "admin");
    add_user("librarian", "lib123", "librarian");
    add_user("customer", "cust123", "customer");

    add_book(1, "The Great Gatsby", "F. Scott Fitzgerald", 5, 10.99);
    add_book(2, "1984", "George Orwell", 3, 8.99);

    char username[50];
    char password[50];
    char role[10];

    printf("Enter username: ");
    scanf("%s", username);
    printf("Enter password: ");
    scanf("%s", password);
    printf("Enter role (admin/librarian/customer): ");
    scanf("%s", role);

    if (authenticate_user(username, password, role)) {
        printf("Login successful!\n");
        if (strcmp(role, "admin") == 0) {
            printf("Admin features:\n");
            // Add admin features here
        } else if (strcmp(role, "librarian") == 0) {
            printf("Librarian features:\n");
            // Add librarian features here
        } else if (strcmp(role, "customer") == 0) {
            printf("Customer features:\n");
            view_books();
            // Add customer features here
        }
    } else {
        printf("Authentication failed.\n");
    }

    return 0;
}
