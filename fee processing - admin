/ Function to process the fee payment
void feeprocess() {
    int transactionId;
    double amount;

    printf("Enter Transaction ID: ");
    scanf("%d", &transactionId);

    printf("Enter the amount paid: ");
    scanf("%lf", &amount);

    // Process the transaction
    totalTransactions++;
    totalRevenue += amount;

    printf("Transaction ID %d has been processed. Fee has been paid.\n", transactionId);
    printf("Total number of fees paid: %d\n", totalTransactions);
    printf("Total revenue made by the library: %.2f tk\n", totalRevenue);
}

// Function to add fee to history
void addFeeToHistory(double fee) {
totalDueFees += fee;
printf("Fee of %.2f tk added to history. Total due fees: %.2f tk\n", fee, totalDueFees);
}

//function for fee update
void feehistory() {
    printf("\n-----Fee History-----\n\n");
    printf("Total due fees: %.2f tk\n", totalDueFees);

    printf("Enter the amount to process for due fees: ");
    double amount;
    scanf("%lf", &amount);

    if (amount <= totalDueFees) {
        totalDueFees -= amount;
        totalTransactions++;
        totalRevenue += amount;
        printf("Processed fee of %.2f tk. Remaining due fees: %.2f tk\n", amount, totalDueFees);
    } else {
        printf("Insufficient due fees. Total due fees available: %.2f tk\n", totalDueFees);
    }

    printf("Total number of fees processed: %d\n", totalTransactions);
    printf("Total revenue made by the library: %.2f tk\n", totalRevenue);
}
